{
  "name": "worldofthemaps",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "npm run check &&  node scripts/build-og-image.mjs && node scripts/build-blog-data.js && vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:client": "vite build",
    "og:build": "node scripts/build-og-image.mjs",
    "atlas:data": "node scripts/build-atlas-data.js",
    "globe:annotate": "node scripts/annotate-topojson.mjs",
    "check": "node scripts/check-globe-join.mjs && node scripts/check-article-facts.mjs && node scripts/check-guess-budget.mjs && node scripts/check-reset-clock.mjs && node scripts/check-hooks.mjs",
    "globe:check": "node scripts/check-globe-join.mjs",
    "blog:check": "node scripts/check-article-facts.mjs",
    "year:data": "node scripts/build-year-data.js",
    "blog:listicles": "node scripts/generate-listicles.js",
    "blog:data": "node scripts/build-blog-data.js",
    "lint": "eslint .",
    "lint:hooks": "node scripts/check-hooks.mjs",
    "preview": "vite preview",
    "schedule": "node scripts/view-dataset-schedule.js",
    "schedule:past": "node scripts/view-dataset-schedule.js -7",
    "schedule:month": "node scripts/view-dataset-schedule.js 30",
    "verify:rotation": "node scripts/verify-rotation.js",
    "datasets:list": "node scripts/list-datasets.js"
  },
  "dependencies": {
    "@vercel/analytics": "^1.5.0",
    "firebase-admin": "^13.5.0",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "react-globe.gl": "^2.36.0",
    "react-router-dom": "^7.9.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "terser": "^5.44.0",
    "vite": "^7.1.6"
  }
}
